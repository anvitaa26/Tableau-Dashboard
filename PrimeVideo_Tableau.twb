      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='amazon_prime_titles+' name='federated.02ohnqu1nzn6b01bxfn041tkxc3n' />
          </datasources>
          <datasource-dependencies datasource='federated.02ohnqu1nzn6b01bxfn041tkxc3n'>
            <column caption='Total ratings' datatype='integer' name='[Calculation_98305140480143362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([title])' />
            </column>
            <column caption='My_index' datatype='integer' name='[Calculation_98305140480765955]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()-1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='My_total' datatype='integer' name='[Calculation_98305140480995332]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MAX([Calculation_98305140480143362])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='My_rank' datatype='integer' name='[Calculation_98305140481323013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE([Calculation_98305140480995332], &apos;asc&apos;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Percentage' datatype='real' name='[Calculation_98305140481802247]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_98305140480995332]/[My_total (copy)_98305140481593350]'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
